# Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_google_api_key_here

# AI Settings
AI_ENABLED=true
AI_MODEL=gemini-3.8-flash

# Database
DATABASE_URL=sqlite:///talentmatch.db
# File Upload Settings
MAX_FILE_SIZE_MB=10
MAX_BATCH_SIZE=500

# Resume Retention (days, 0 = indefinite)
RESUME_RETENTION_DAYS=365

# Debug Mode
DEBUG_MODE=false

# Server
APP_HOST=localhost
APP_PORT=8501

# SMTP Email Dispatch Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=SMTP_USER
SMTP_PASSWORD=SMTP_PASSWORD
SMTP_USE_TLS=true

# Multiple allowed sender addresses (comma-separated, selectable from the UI)
SENDER_EMAILS=SMTP_USER

# # WhatsApp Recruiter Outreach Settings
# WHATSAPP_ENABLED=true
# # Provider options: 'web_direct' (1-click WhatsApp Web/App, no API key needed), 'twilio', 'meta', 'simulation'
# WHATSAPP_PROVIDER=web_direct
# DEFAULT_COUNTRY_CODE=+91

# # Twilio WhatsApp API (Optional: for automated backend dispatch)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# # Meta WhatsApp Business Cloud API (Optional)
# META_WHATSAPP_TOKEN=
# META_PHONE_NUMBER_ID=
